# local-rag-ollama settings. Copy to .env (git-ignored) or export them. No API keys exist:
# everything runs locally. Every value below is the default.

# ollama on this machine. Remote hosts are refused unless LOCAL_RAG_ALLOW_REMOTE_OLLAMA=1.
OLLAMA_HOST=http://127.0.0.1:11434
LOCAL_RAG_ALLOW_REMOTE_OLLAMA=0

# Index file (SQLite + FTS5 + sqlite-vec), created 0600.
# LOCAL_RAG_DB=~/.local/share/local-rag/index.sqlite3

# Embeddings: ollama | fastembed | hashing
LOCAL_RAG_EMBEDDER=ollama
LOCAL_RAG_EMBED_MODEL=nomic-embed-text
LOCAL_RAG_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
LOCAL_RAG_HASHING_DIM=512

# Generation and the eval judge (any ollama chat model)
LOCAL_RAG_CHAT_MODEL=qwen3:4b
LOCAL_RAG_JUDGE_MODEL=qwen3:4b
LOCAL_RAG_TEMPERATURE=0

# Retrieval: bm25 | vector | hybrid | hybrid+rerank
LOCAL_RAG_MODE=hybrid
LOCAL_RAG_TOP_K=5
LOCAL_RAG_CANDIDATES=30
LOCAL_RAG_RRF_K=60
LOCAL_RAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
LOCAL_RAG_MIN_SIMILARITY=0.3

# Chunking and ingest limits
LOCAL_RAG_CHUNK_CHARS=1200
LOCAL_RAG_OVERLAP_CHARS=200
LOCAL_RAG_MAX_FILE_BYTES=20971520

# CPU threads for fastembed (0 = onnxruntime decides) and the HTTP timeout to ollama
LOCAL_RAG_THREADS=0
LOCAL_RAG_TIMEOUT=120
